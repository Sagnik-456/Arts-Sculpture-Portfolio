# Copy this file to ".env" and fill in the values.

# Port the site listens on
PORT=3000

# REQUIRED in production: a long random string used to sign login cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to "production" when deployed (enables secure cookies & caching)
NODE_ENV=development

# Optional: create the admin login automatically on first start (if none exists yet).
# Remove these after the first start, or use "npm run create-admin" instead.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: where the database and uploaded images are stored (point these at a persistent disk when hosting).
# DATA_DIR=./data
# UPLOAD_DIR=./uploads

# Optional: e-mail notification for each new enquiry. Without this, enquiries are still saved in Admin → Enquiries.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# NOTIFY_EMAIL=          # defaults to the contact e-mail set in Admin → Settings
