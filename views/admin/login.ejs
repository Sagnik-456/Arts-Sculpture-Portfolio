<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Sign in · Studio admin</title>
  <link rel="icon" href="/static/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/admin.css">
</head>
<body class="adm adm-login-page">
  <form class="adm-login" method="post" action="/admin/login">
    <p class="adm-eyebrow">Studio admin</p>
    <h1><%= site.artist_name %></h1>
    <% if (!hasAdmin) { %>
      <div class="adm-flash adm-flash-error">No admin account exists yet. In the project folder run:<br><code>npm run create-admin</code></div>
    <% } %>
    <% if (error) { %><div class="adm-flash adm-flash-error" role="alert"><%= error %></div><% } %>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="adm-field"><span>Username</span><input name="username" autocomplete="username" required autofocus></label>
    <label class="adm-field"><span>Password</span><input name="password" type="password" autocomplete="current-password" required></label>
    <button class="adm-btn adm-btn-ink adm-btn-block" type="submit">Sign in</button>
    <a class="adm-back" href="/">← Back to website</a>
  </form>
  <script src="/static/js/admin.js"></script>
</body>
</html>
