<%- include('_top') %>
<header class="adm-head">
  <div><p class="adm-eyebrow">Organise</p><h1>Categories</h1></div>
  <a class="adm-btn adm-btn-ink" href="/admin/categories/new">+ New category</a>
</header>
<p class="adm-muted">Categories appear as tiles and rows on the home page in this order. Hidden categories (and their works) are not shown publicly.</p>

<div class="adm-table-wrap">
<table class="adm-table">
  <thead><tr><th>Order</th><th>Category</th><th>Works</th><th>Status</th><th></th></tr></thead>
  <tbody>
  <% categories.forEach((c, i) => { %>
    <tr>
      <td class="adm-order">
        <form method="post" action="/admin/categories/<%= c.id %>/move"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="dir" value="up"><button class="adm-icon" <%= i === 0 ? 'disabled' : '' %> aria-label="Move up">↑</button></form>
        <form method="post" action="/admin/categories/<%= c.id %>/move"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="dir" value="down"><button class="adm-icon" <%= i === categories.length - 1 ? 'disabled' : '' %> aria-label="Move down">↓</button></form>
      </td>
      <td><div class="adm-row-title">
        <% if (c.cover) { %><img src="<%= c.cover.sm %>" alt=""><% } else { %><span class="adm-thumb-ph"></span><% } %>
        <span><b><%= c.name %></b><small>/category/<%= c.slug %></small></span></div></td>
      <td><a href="/admin/works?category=<%= c.id %>"><%= c.total %></a></td>
      <td><span class="adm-pill <%= c.visible ? 'adm-pill-ok' : '' %>"><%= c.visible ? 'Visible' : 'Hidden' %></span></td>
      <td class="adm-actions">
        <a class="adm-btn adm-btn-sm adm-btn-yellow" href="/admin/works/new?category=<%= c.id %>">+ Work</a>
        <a class="adm-btn adm-btn-sm" href="/admin/categories/<%= c.id %>/edit">Edit</a>
        <form method="post" action="/admin/categories/<%= c.id %>/delete" data-confirm="Delete the category “<%= c.name %>”? This cannot be undone.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="adm-btn adm-btn-sm adm-btn-danger">Delete</button></form>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
<%- include('_bottom') %>
